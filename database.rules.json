{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      ".indexOn": ["referralCode", "referredBy"],
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || auth.token.admin == true)",
        "balance": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth.token.admin == true"
        },
        "reservedBalance": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth.token.admin == true"
        },
        "referralCode": {
          ".read": "auth != null",
          ".write": "auth.token.admin == true"
        },
        "referralCount": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth.token.admin == true"
        },
        "referredBy": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth.token.admin == true"
        },
        "referralStartDate": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth.token.admin == true"
        },
        "referralEndDate": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth.token.admin == true"
        }
      }
    },
    "transactions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth.token.admin == true"
      }
    },
    "deposits": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth.token.admin == true",
        ".indexOn": ["referenceId", "moncashReference", "status", "createdAt"]
      }
    },
    "withdrawals": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth.token.admin == true",
        ".indexOn": ["moncashReference", "referenceId", "status", "createdAt"]
      }
    },
    "deposit_index": {
      ".read": "auth.token.admin == true",
      ".write": "auth.token.admin == true",
      ".indexOn": ["userId", "referenceId", "moncashReference", "status"]
    },
    "processed_webhooks": {
      ".read": "auth.token.admin == true",
      ".write": "auth.token.admin == true"
    },
    "processed_events": {
      ".read": "auth.token.admin == true",
      ".write": "auth.token.admin == true"
    },
    "failed_webhook_events": {
      ".read": "auth.token.admin == true",
      ".write": "auth.token.admin == true"
    },
    "wallet_transactions": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth.token.admin == true",
        ".indexOn": ["referenceId", "type", "status", "createdAt"]
      }
    },
    "ledger": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth.token.admin == true"
      }
    },
    "referralRewards": {
      ".read": "auth.token.admin == true",
      ".write": "auth.token.admin == true"
    },
    "auditLogs": {
      ".read": "auth.token.admin == true",
      ".write": "auth.token.admin == true"
    },
    "webhookIdempotency": {
      ".read": "auth.token.admin == true",
      ".write": "auth.token.admin == true"
    },
    "withdrawalRateLimit": {
      ".read": "auth.token.admin == true",
      ".write": "auth.token.admin == true"
    },
    "rooms": {
      ".read": true,
      ".write": "auth != null"
    },
    "settings": {
      ".read": true,
      ".write": "auth.token.admin == true"
    }
  }
}
